NODE_ENV=development
PORT=4000

# Pooled Neon URL in production; db container locally (see docker-compose.yml)
DATABASE_URL=postgresql://arcane:arcane@localhost:5432/arcane
# Direct (non-pooled) Neon URL for production migrations; empty locally
DIRECT_URL=

# Long random string, different for each environment
JWT_SECRET=
# Token and session cookie lifetime
JWT_EXPIRES_IN=7d

# Exact frontend origin(s), comma-separated
CORS_ORIGIN=http://localhost:3000
# Domain shared by the frontend and the API (session cookie); empty locally
COOKIE_DOMAIN=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# debug locally, info in production
LOG_LEVEL=debug

# Password of the demo GM account (npm run seed:demo)
DEMO_GM_PASSWORD=

NODE_ENV=development
PORT=4000

# URL Neon poolée en production ; conteneur db en local (voir docker-compose.yml)
DATABASE_URL=postgresql://arcane:arcane@localhost:5432/arcane

# Chaîne aléatoire longue, différente par environnement
JWT_SECRET=
# Durée de validité du jeton (valeur à définir, ex. "7d")
JWT_EXPIRES_IN=

# Origine exacte du frontend
CORS_ORIGIN=http://localhost:3000
# Domaine commun au front et à l'API (cookie de session)
COOKIE_DOMAIN=localhost

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# debug en local, info en production
LOG_LEVEL=debug

# Mot de passe du compte MJ de démonstration (npm run seed:demo)
DEMO_GM_PASSWORD=

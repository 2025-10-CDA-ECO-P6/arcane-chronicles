{
  "name": "Arcane Chronicles",
  "dockerComposeFile": ["../docker-compose.yml", "compose.yaml"],
  "service": "workspace",
  "runServices": ["db", "workspace"],
  "workspaceFolder": "/workspace",
  "remoteUser": "node",
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/node/.claude"
  },
  "forwardPorts": [3000, 4000, 5432],
  "portsAttributes": {
    "3000": { "label": "Front" },
    "4000": { "label": "API" },
    "5432": { "label": "PostgreSQL", "onAutoForward": "silent" }
  },
  "postCreateCommand": "sudo chown -R node:node node_modules apps/*/node_modules packages/*/node_modules apps/web/.next /home/node/.cache/ms-playwright /home/node/.claude && npm ci && npm run prisma:generate && npx playwright install chromium",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "Prisma.prisma",
        "ms-playwright.playwright",
        "anthropic.claude-code",
        "ms-ossdata.vscode-pgsql"
      ],
      "settings": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true
      }
    }
  }
}
